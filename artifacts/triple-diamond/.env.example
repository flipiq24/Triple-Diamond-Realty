# Triple Diamond Realty — environment configuration
# Each tenant deployment overrides these values.

# REQUIRED: The Command backend API URL for this tenant.
# All auth + MLS hot deals API calls go here.
# Example: https://api-command.flipiq.com
VITE_API_URL=

# OPTIONAL: Tenant display name (used for branding labels).
# Example: Command, DBTM, Lau, Vetted Buyers
VITE_TENANT_NAME=
