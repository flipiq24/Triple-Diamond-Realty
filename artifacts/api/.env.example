# @workspace/api — environment configuration
# Deployed once, serves all tenants.

# REQUIRED: Shared cross-tenant property data lake (mls.listings live here)
PROPERTY_DATA_URL=postgresql://USER:PASS@platform-prod.c30ygwiuq37j.us-west-2.rds.amazonaws.com/property-data

# REQUIRED per tenant: connection string for that tenant's Postgres.
# Env-var naming: DATABASE_URL_<UPPERCASE_TENANT_SLUG>
# The tenant slug is what appears in the URL path (/{tenant}/mls, etc.)
DATABASE_URL_DEVCOMMAND=postgresql://USER:PASS@platform-prod.c30ygwiuq37j.us-west-2.rds.amazonaws.com/devcommandpes
DATABASE_URL_COMMAND=postgresql://USER:PASS@platform-prod.c30ygwiuq37j.us-west-2.rds.amazonaws.com/commandpes
DATABASE_URL_DBTM=postgresql://USER:PASS@platform-prod.c30ygwiuq37j.us-west-2.rds.amazonaws.com/dbtmpes
DATABASE_URL_LAU=postgresql://USER:PASS@platform-prod.c30ygwiuq37j.us-west-2.rds.amazonaws.com/laupes

# OPTIONAL: photo URL base for filenames stored in idx.uploadimages.
UPLOAD_PICTURES_URL=https://cdn.example.com/uploads

# REQUIRED: comma-separated allowlist of TDR origins.
ALLOWED_ORIGINS=https://buyers.command.flipiq.com,https://buyers.dbtm.flipiq.com,https://buyers.lau.flipiq.com,http://localhost:3000

# OPTIONAL: Supabase (service role) for /:tenant/buyers/preferences.
# When missing, endpoint returns hardcoded defaults.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Node env
NODE_ENV=development
PORT=4000
