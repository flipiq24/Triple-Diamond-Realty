# Triple Diamond Realty — environment configuration
# Each tenant deployment overrides these values.

# REQUIRED: The Command backend base URL (shared across tenants).
# All API calls are prefixed: {VITE_API_URL}/{VITE_TENANT_NAME}/{path}
VITE_API_URL=https://d2d89uov8t23t8.cloudfront.net

# REQUIRED: Tenant slug (used as the path segment in every API call).
# Example values: command, dbtm, lau, vettedbuyers
VITE_TENANT_NAME=command
