# Triple Diamond Realty — environment configuration
# Each tenant deployment overrides these values.

# REQUIRED: The Command backend base URL (shared across tenants).
# All MLS API calls are prefixed: {VITE_API_URL}/{VITE_TENANT_NAME}/{path}
VITE_API_URL=https://d2d89uov8t23t8.cloudfront.net

# REQUIRED: Tenant slug (used as the path segment in every API call).
# Example values: command, dbtm, lau, vettedbuyers
VITE_TENANT_NAME=command

# REQUIRED: Supabase project URL for this tenant.
# Each tenant has its own Supabase project — find in Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# REQUIRED: Supabase anon (public) key for this tenant.
# Safe to expose to the browser. Find in Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_ANON_KEY=

# OPTIONAL: Branding tenant override.
#
# Normally the buyer site pulls Buyers Hook branding from the same tenant
# slug it uses everywhere (VITE_TENANT_NAME). Set this only when you want
# the branding to come from a DIFFERENT tenant's DB — e.g. this deployment
# runs at buyers.command.flipiq.com but the Buyers Hook config actually
# lives in the `devcommand` tenant's Command DB, because Command's own
# migration hasn't run yet.
#
# When set, the /buyers/preferences call sends ?tenant=<value> and the API
# reads that tenant's config (still validated against TENANT_ALLOWLIST).
# When unset, the API falls back to the URL-path tenant like before.
# VITE_PREFERENCES_TENANT=devcommand
