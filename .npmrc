auto-install-peers=false
strict-peer-dependencies=false
engine-strict=false

# Hoist every @types/* package to the top-level node_modules/@types folder
# so tsc can walk into transitive type deps (e.g. @types/express pulling in
# @types/express-serve-static-core) without traversing pnpm's .pnpm store.
# Local runs happen to resolve these via symlinks, but Vercel's monorepo
# install rearranges the symlink layout during function-bundling and the
# transitive @types become unreachable — tsc then reports methods like
# res.status() / res.json() as missing on Express types.
public-hoist-pattern[]=@types/*
