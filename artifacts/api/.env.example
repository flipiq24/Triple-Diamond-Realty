# @workspace/api — environment configuration
# Deployed ONCE on Vercel. Serves all tenants.
# Tenant is read from the URL path: /{tenant}/mls, /{tenant}/property-details/:id, etc.

# ─── REQUIRED ────────────────────────────────────────────────────────────
# Shared cross-tenant property data lake. Provides mls.listings for all tenants.
PROPERTY_DATA_URL=postgresql://USER:PASS@platform-prod.c30ygwiuq37j.us-west-2.rds.amazonaws.com/property-data

# Template for per-tenant DB URL. The literal string {tenant} is replaced with
# the tenant slug from the URL path at request time.
# Example URL constructed for tenant "command":
#   postgresql://USER:PASS@host/commandpes
TENANT_DB_URL_TEMPLATE=postgresql://USER:PASS@platform-prod.c30ygwiuq37j.us-west-2.rds.amazonaws.com/{tenant}pes

# CORS
#
# Every `https://*.flipiq.com` subdomain is allowed automatically by a regex
# in middleware/cors.ts — you do NOT need to list buyers.<tenant>.flipiq.com
# entries here.
#
# Use ALLOWED_ORIGINS only for exact-match origins that fall OUTSIDE that
# pattern: raw *.vercel.app preview URLs, localhost during dev, or partner
# domains. Comma-separated.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4001

# ─── STRONGLY RECOMMENDED ───────────────────────────────────────────────
# Safety allowlist. Comma-separated tenant slugs. If set, only these are
# accepted; anything else returns 404.
TENANT_ALLOWLIST=command,devcommand,dbtm,lau,vettedbuyers,dool,affirm,acquired,fwolf,inv,isocal,lafingroup,simply,stj

# ─── OPTIONAL ───────────────────────────────────────────────────────────
# Per-tenant override. Useful for tenants whose DB name doesn't follow the
# template (e.g. legacy names without "pes" suffix, different host, etc.).
# Naming: DATABASE_URL_<UPPERCASE_SLUG> — takes precedence over the template.
# DATABASE_URL_BUYERIQ=postgresql://USER:PASS@host/buyeriq

# Photo URL base — filenames stored in idx.uploadimages are just names like
# "abc123.jpg"; we prepend this to make full URLs. Ask Faisal for the value
# — same one used by Command's backend.
UPLOAD_PICTURES_URL=https://cdn.flipiq.com/uploads

# ─── /buyers/preferences (branding) ─────────────────────────────────────
# Tenant branding lives in each tenant's Command DB as a single jsonb blob
# (Faisal's schema). Adding new configurable fields (fonts, hero image,
# etc.) later doesn't need a DB migration OR a TDR code change.
# Falls back to hardcoded defaults if the table/column doesn't exist yet.
PREFERENCES_TABLE=sys.buyer_preferences
PREFERENCES_COLUMN=preferences

# ─── /agent-contact + /sell-property-notify (tenant email routing) ─────
# When a buyer submits the property-page "Contact a buyer's agent" form
# OR the Sell a Property form, the tenant's configured recipient (from
# Buyers Hook sections[].fields[] — `agent_contact_email`, falling back
# to `primary_email`) receives a Resend email. Contact-agent submissions
# also audit-write into Supabase `agent_contact_requests`. Requires:
#
#   RESEND_API_KEY                 — from resend.com dashboard
#   AGENT_CONTACT_FROM_EMAIL       — verified sender in Resend. Must be a
#                                    domain you've DNS-verified in Resend.
#                                    `buyers@flipiq.com` is the canonical
#                                    sender for every tenant's buyer site.
#   AGENT_CONTACT_FALLBACK_EMAIL   — last-resort recipient if the tenant
#                                    admin hasn't configured either
#                                    `agent_contact_email` or `primary_email`
#                                    yet. `buyers@flipiq.com` keeps leads
#                                    landing in a central inbox so nothing
#                                    is silently dropped mid-onboarding.
#   SUPABASE_URL, SUPABASE_ANON_KEY — for the agent-contact audit write;
#                                    the anon key is sufficient because
#                                    agent_contact_requests has an
#                                    anon-insert RLS policy.
RESEND_API_KEY=
AGENT_CONTACT_FROM_EMAIL=buyers@flipiq.com
AGENT_CONTACT_FALLBACK_EMAIL=buyers@flipiq.com
SUPABASE_URL=https://alatvfxkxiohtqzqjolw.supabase.co
SUPABASE_ANON_KEY=

# Node / dev
NODE_ENV=development
PORT=4000
