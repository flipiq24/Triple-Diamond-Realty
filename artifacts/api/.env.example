# @workspace/api — environment configuration
# Deployed ONCE on Vercel. Serves all tenants.
# Tenant is read from the URL path: /{tenant}/mls, /{tenant}/property-details/:id, etc.

# ─── REQUIRED ────────────────────────────────────────────────────────────
# Shared cross-tenant property data lake. Provides mls.listings for all tenants.
PROPERTY_DATA_URL=postgresql://USER:PASS@platform-prod.c30ygwiuq37j.us-west-2.rds.amazonaws.com/property-data

# Template for per-tenant DB URL. The literal string {tenant} is replaced with
# the tenant slug from the URL path at request time.
# Example URL constructed for tenant "command":
#   postgresql://USER:PASS@host/commandpes
TENANT_DB_URL_TEMPLATE=postgresql://USER:PASS@platform-prod.c30ygwiuq37j.us-west-2.rds.amazonaws.com/{tenant}pes

# CORS: comma-separated list of TDR frontend origins allowed to call the API.
ALLOWED_ORIGINS=https://buyers.command.flipiq.com,https://buyers.dbtm.flipiq.com,https://buyers.lau.flipiq.com,http://localhost:3000

# ─── STRONGLY RECOMMENDED ───────────────────────────────────────────────
# Safety allowlist. Comma-separated tenant slugs. If set, only these are
# accepted; anything else returns 404. If unset, ANY well-formed slug is
# accepted (still safe — just relies on the template pointing at a real DB).
TENANT_ALLOWLIST=command,devcommand,dbtm,lau,vettedbuyers,dool,affirm,acquired,fwolf,inv,isocal,lafingroup,simply,stj

# ─── OPTIONAL ───────────────────────────────────────────────────────────
# Per-tenant override. Useful for tenants whose DB name doesn't follow the
# template (e.g. legacy names without "pes" suffix, different host, etc.).
# Naming: DATABASE_URL_<UPPERCASE_SLUG> — takes precedence over the template.
# DATABASE_URL_BUYERIQ=postgresql://USER:PASS@host/buyeriq

# Photo URL base — filenames stored in idx.uploadimages are just names like
# "abc123.jpg"; we prepend this to make full URLs. Ask Faisal for the value
# — same one used by Command's backend.
UPLOAD_PICTURES_URL=https://cdn.flipiq.com/uploads

# Supabase — only needed for the /:tenant/buyers/preferences endpoint.
# When unset, that endpoint returns hardcoded defaults (navy + orange + "Triple Diamond Realty").
# Use the SERVICE ROLE key (server-side only, bypasses RLS, never expose to browser).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Node / dev
NODE_ENV=development
PORT=4000
